# =============================================================================
# NyayaVault — environment template
# =============================================================================
# Copy to `.env` and replace EVERY placeholder before running anything:
#
#     cp .env.example .env
#
# Generate strong values with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# `.env` is git-ignored. Never commit real secrets.
# =============================================================================

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=nyayavault
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=nyayavault
POSTGRES_HOST_PORT=5432

# Used by the backend. Docker Compose overrides this to point at the `db`
# service; the value below is what you want when running the API on the host.
DATABASE_URL=postgresql+psycopg2://nyayavault:CHANGE_ME_strong_db_password@localhost:5432/nyayavault

# --------------------------------------------------------------------- MinIO
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001

# Credentials the API uses to talk to MinIO. M0 reuses the root credentials for
# simplicity. In production, create a scoped MinIO service account restricted to
# the documents bucket and use it here instead.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_user
MINIO_SECRET_KEY=CHANGE_ME_minio_password_min_8_chars
MINIO_BUCKET=nyayavault-documents
MINIO_SECURE=false

# ----------------------------------------------------------------------- JWT
# MUST be replaced. The API refuses to start when APP_ENV=production with a
# weak or placeholder secret, and logs a loud warning in development.
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_char_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --------------------------------------------------------------- Application
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
BACKEND_HOST_PORT=8000

# Upload policy
MAX_UPLOAD_BYTES=52428800

# ------------------------------------------------------------------- Seeding
# Password for the bootstrap ADMIN account created by `python -m app.seed`.
# If left EMPTY, seeding creates roles and departments but NO admin user —
# there is deliberately no default password anywhere in this repository.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@nyayavault.local
SEED_ADMIN_PASSWORD=

# ------------------------------------------------------------------ Frontend
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
